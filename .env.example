# Copy to .env.local and fill in. Never commit .env.local.

# Model provider (server only): runs every chat model and FLUX images
NVIDIA_API_KEY=

# Signs session cookies. Any long random string.
SESSION_SECRET=

# Admin page: scrypt hash only, never the password (see README "Admin")
ADMIN_PASSWORD_HASH=

# Chain. Leave RPC_URL empty to run on the mock chain.
CHAIN_ID=4663
RPC_URL=https://rpc.mainnet.chain.robinhood.com
CONFIRMATIONS=20
LOG_CHUNK_BLOCKS=1000
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Top-ups in USDG on Robinhood Chain
USDG_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
USDG_DECIMALS=6

# Every deposit address is derived from this seed. Created by scripts/go-live.mjs if empty. Back it up.
DEPOSIT_MNEMONIC=

# Token (the contract can also be set at runtime in /admin)
TOKEN_ADDRESS=
TOKEN_DECIMALS=18
TOKEN_PRICE_USD=0
TOKEN_REVIEW_USD=500
NEXT_PUBLIC_CONTRACT=

# Holder Credit: off while the pool is 0 (the site then says "planned")
HOLDER_POOL_USD_PER_HOUR=0
HOLDER_MIN_USD=20
HOLDER_MIN_TOKENS=0

# Optional dev codes, CODE:dollars,CODE2:dollars (ignored on mainnet)
REDEEM_CODES=
